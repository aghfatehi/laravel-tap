<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Tap Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="TAP_SANDBOX_MODE" value="true"/>
        <env name="TAP_SECRET_KEY" value="sk_test_xxxxxxxxxxxxxxxx"/>
        <env name="TAP_MERCHANT_ID" value="test_merchant"/>
    </php>
</phpunit>
