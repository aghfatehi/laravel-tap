{
    "name": "aghfatehi/laravel-tap",
    "description": "Tap Payment Gateway Integration for Laravel - Accept payments via Tap (supports KNET, Mada, Visa, Mastercard, Apple Pay, STC Pay, Tabby, Tamara, and more).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tap",
        "payment",
        "gateway",
        "knet",
        "mada",
        "stcpay",
        "apple-pay",
        "saudi-arabia",
        "middle-east"
    ],
    "support": {
        "issues": "https://github.com/aghfatehi/laravel-tap/issues",
        "source": "https://github.com/aghfatehi/laravel-tap"
    },
    "authors": [
        {
            "name": "AL-AGHBARI Fatehi",
            "email": "fathi.a.n2002@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Aghfatehi\\Tap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aghfatehi\\Tap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aghfatehi\\Tap\\TapServiceProvider"
            ],
            "aliases": {
                "Tap": "Aghfatehi\\Tap\\Facades\\Tap"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    }
}
